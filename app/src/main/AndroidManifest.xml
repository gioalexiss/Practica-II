<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PR_GARG_II">

        <!-- Pantalla de bienvenida -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla del catálogo -->
        <activity android:name=".ui.CatalogActivity" android:exported="false" />
        <!-- Pantalla de detalle -->
        <activity android:name=".ui.DetailActivity" android:exported="false" />
        <!-- Favoritos sin Internet -->
        <activity android:name=".ui.FavoritesActivity" android:exported="false" />
    </application>

</manifest>
